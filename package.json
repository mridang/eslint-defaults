{
  "name": "@mridang/eslint-defaults",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build && eslint .",
    "lint:fix": "npm run build && eslint . --fix",
    "prepack": "tsc",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=jest.config.mjs",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "author": "Mridang Agarwalla <mridang.agarwalla@gmail.com> (https://github.com/mridang)",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "A set of sane default for the NestJS framework",
  "private": false,
  "peerDependencies": {
    "eslint": "^9.38.0 || ^10.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/eslint-defaults.git"
  },
  "homepage": "https://github.com/mridang/eslint-defaults",
  "bugs": {
    "url": "https://github.com/mridang/eslint-defaults/issues"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "knip": "^6.45.1",
    "minimatch": "^11.0.3",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-cypress": "^7.0.4",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.9.4",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-package-json": "^1.14.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-tailwindcss-v3": "npm:eslint-plugin-tailwindcss@^3.18.3",
    "eslint-plugin-testing-library": "^7.15.1",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-yml": "^3.10.0",
    "globals": "^17.14.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.1",
    "vue-eslint-parser": "^10.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "2.2.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
